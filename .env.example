# APRO — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit real credentials, passwords, or production keys to version control.

# ------------------------------------------------------------------------------
# Application Service Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Database Connections
# ------------------------------------------------------------------------------
# Primary backend and Live Reviewer Dashboard database (Judge / Demo DB)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@127.0.0.1:5432/apro_test_db

# Test runner and integration test database
POSTGRES_TEST_URL=postgresql+asyncpg://<username>:<password>@127.0.0.1:5432/apro_attack_db

# Demo database verified for non-mutation by Phase 17 adversarial security harness
POSTGRES_DEMO_URL=postgresql+asyncpg://<username>:<password>@127.0.0.1:5432/apro_test_db

# ------------------------------------------------------------------------------
# Provider Integration (Razorpay Test Mode)
# ------------------------------------------------------------------------------
# Webhook verification secret (Test Mode only)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_test_webhook_secret_here

# Provider API credentials (rzp_test_... only; rzp_live_ keys are strictly blocked)
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_test_key_secret_here
